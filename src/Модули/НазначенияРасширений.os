// Назначения расширений - как у расширений конфигурации 1С.
//
// Назначение определяет, в каком порядке расширения применяются к желудю:
// сначала исправления, затем адаптации, затем дополнения. Каждое следующее
// расширение оборачивает предыдущие, поэтому исправление ближе всех к исходному
// методу, а дополнение - дальше всех.

Перем Назначения;

// Исправление ошибок расширяемого желудя. Применяется первым.
//
//  Возвращаемое значение:
//   Строка
//
Функция Исправление() Экспорт
	Возврат "Исправление";
КонецФункции

// Адаптация расширяемого желудя под конкретное применение. Применяется после исправлений.
//
//  Возвращаемое значение:
//   Строка
//
Функция Адаптация() Экспорт
	Возврат "Адаптация";
КонецФункции

// Дополнение расширяемого желудя новыми возможностями. Применяется последним.
//
//  Возвращаемое значение:
//   Строка
//
Функция Дополнение() Экспорт
	Возврат "Дополнение";
КонецФункции

// Проверяет, является ли значение известным назначением расширения.
//
// Параметры:
//   Назначение - Произвольный - Проверяемое значение.
//
//  Возвращаемое значение:
//   Булево - Истина, если значение - одно из назначений расширения.
//
Функция ЭтоНазначениеРасширения(Назначение) Экспорт
	Возврат Назначения.Найти(Назначение) <> Неопределено;
КонецФункции

// Назначения в порядке применения.
//
//  Возвращаемое значение:
//   ФиксированныйМассив из Строка
//
Функция ВсеНазначения() Экспорт
	Возврат Новый ФиксированныйМассив(Назначения);
КонецФункции

Назначения = Новый Массив();
Назначения.Добавить(Исправление());
Назначения.Добавить(Адаптация());
Назначения.Добавить(Дополнение());
