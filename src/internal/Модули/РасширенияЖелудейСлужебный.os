#Использовать annotations
#Использовать collectionos
#Использовать autumn

// Чтение и проверка расширений желудей.
//
// Описание расширения - см. ОписаниеРасширения. Всё, что можно проверить по самому
// классу расширения, проверяется здесь. Проверки, которым нужен расширяемый желудь
// (есть ли у него метод, совпадают ли параметры), выполняет ПрименительРасширений.

#Область ОписаниеПеременных

// Массив из Строка - Имена аннотаций перехвата.
Перем ВидыПерехвата;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Вид перехвата "Перед", см. АннотацияПеред.
//
//  Возвращаемое значение:
//   Строка
//
Функция Перед() Экспорт
	Возврат "Перед";
КонецФункции

// Вид перехвата "После", см. АннотацияПосле.
//
//  Возвращаемое значение:
//   Строка
//
Функция После() Экспорт
	Возврат "После";
КонецФункции

// Вид перехвата "Вместо", см. АннотацияВместо.
//
//  Возвращаемое значение:
//   Строка
//
Функция Вместо() Экспорт
	Возврат "Вместо";
КонецФункции

// Проверяет имя перехватываемого метода, заданное в аннотации перехвата.
//
// Параметры:
//   Значение - Произвольный - Значение параметра аннотации
//   ИмяАннотации - Строка - Имя аннотации для текста ошибки
//
//  Возвращаемое значение:
//   Строка - Имя перехватываемого метода
//
Функция ИмяПерехватываемогоМетода(Значение, ИмяАннотации) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		ВызватьИсключение СтрШаблон("В аннотации &%1 не указано имя перехватываемого метода", ИмяАннотации);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Проверяет, что определение желудя - расширение.
//
// Параметры:
//   ОпределениеЖелудя - ОпределениеЖелудя - Проверяемое определение
//
//  Возвращаемое значение:
//   Булево - Истина, если желудь помечен аннотацией &Расширение
//
Функция ЭтоРасширение(ОпределениеЖелудя) Экспорт

	Если ОпределениеЖелудя.Прозвища().Найти("Расширение") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат АннотацияРасширения(ОпределениеЖелудя) <> Неопределено;

КонецФункции

// Читает описание расширения из определения его желудя и проверяет методы расширения.
//
// Параметры:
//   ОпределениеРасширения - ОпределениеЖелудя - Определение желудя расширения, см. ЭтоРасширение
//   Поделка - Поделка - Контекст приложения, из которого берутся определения аннотаций
//
//  Возвращаемое значение:
//   Структура - Описание расширения:
//     * Имя - Строка - Имя желудя расширения
//     * Цель - Строка - Имя или прозвище расширяемого желудя
//     * Назначение - Строка - см. НазначенияРасширений
//     * Порядок - Число - Порядок расширения внутри назначения
//     * Перехваты - СписокМассив из Структура - Перехваты методов, в порядке объявления методов:
//       ** Вид - Строка - см. Перед, После, Вместо
//       ** ИмяМетода - Строка - Имя перехватываемого метода
//       ** МетодРасширения - Строка - Имя метода расширения
//       ** КоличествоПараметров - Число - Количество параметров метода расширения
//       ** ПараметрыПоЗначению - Массив из Булево - Признаки Знач параметров метода расширения
//       ** ЭтоФункция - Булево - Метод расширения - функция
//     * ДобавляемыеМетоды - СписокМассив из Строка - Экспортные методы расширения без аннотаций перехвата:
//                           они становятся методами расширяемого желудя
//
Функция ОписаниеРасширения(ОпределениеРасширения, Поделка) Экспорт

	Аннотация       = АннотацияРасширения(ОпределениеРасширения);
	ОбъектАннотации = Поделка.ПолучитьОпределениеАннотации("Расширение").СоздатьОбъектАннотации(Аннотация);
	Цель            = ОбъектАннотации.Цель();

	ПроверитьЦель(ОпределениеРасширения, Цель);
	ПроверитьХарактер(ОпределениеРасширения);

	Описание = Новый Структура;
	Описание.Вставить("Имя", ОпределениеРасширения.Имя());
	Описание.Вставить("Цель", Цель);
	Описание.Вставить("Назначение", ОбъектАннотации.Назначение());
	Описание.Вставить("Порядок", ОпределениеРасширения.Порядок());
	Описание.Вставить("Перехваты", Перехваты(ОпределениеРасширения, Поделка));
	Описание.Вставить("ДобавляемыеМетоды", ДобавляемыеМетоды(ОпределениеРасширения));

	Возврат Описание;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АннотацияРасширения(ОпределениеЖелудя)
	Возврат РаботаСАннотациями.НайтиАннотацию(ОпределениеЖелудя.Завязь().ДанныеМетода().Аннотации, "Расширение");
КонецФункции

Процедура ПроверитьЦель(ОпределениеРасширения, Цель)

	Если ОпределениеРасширения.Прозвища().Найти(Цель) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Расширение %1 не может расширять само себя: ""%2"" - его собственное имя или прозвище",
		ОпределениеРасширения.Имя(),
		Цель
	);

КонецПроцедуры

// Как в 1С, расширение - часть расширяемого объекта: его состояние живёт столько же,
// сколько экземпляр желудя. Поэтому расширение всегда компанейское (&Расширение добавляет
// &Характер("Компанейский")) и создаётся на каждое применение: у желудя-одиночки
// оно одно, у компанейского - своё у каждого экземпляра.
Процедура ПроверитьХарактер(ОпределениеРасширения)

	АннотацииКонструктора = ОпределениеРасширения.Завязь().ДанныеМетода().Аннотации;

	Для Каждого Аннотация Из РаботаСАннотациями.НайтиАннотации(АннотацииКонструктора, "Характер") Цикл

		Характер = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(Аннотация);

		Если Характер = ХарактерыЖелудей.Компанейский() Тогда
			Продолжить;
		КонецЕсли;

		ВызватьИсключение СтрШаблон(
			"У расширения %1 указан &Характер(""%2""). Расширение живёт вместе с расширяемым желудем:"
			+ " у одиночки оно одно, у компанейского желудя - своё у каждого экземпляра."
			+ " Уберите аннотацию &Характер",
			ОпределениеРасширения.Имя(),
			Характер
		);

	КонецЦикла;

КонецПроцедуры

// Экспортные методы расширения без аннотаций перехвата, кроме конструктора.
Функция ДобавляемыеМетоды(ОпределениеРасширения)

	Результат = Новый СписокМассив();

	Для Каждого Метод Из ОпределениеРасширения.Методы() Цикл

		Если АннотацииПерехвата(Метод).Количество() > 0
			Или НРег(Метод.Имя) = НРег("ПриСозданииОбъекта")
			Или НРег(Метод.Имя) = НРег("OnObjectCreation") Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Метод.Имя);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Перехваты(ОпределениеРасширения, Поделка)

	ПроверитьНеэкспортныеМетоды(ОпределениеРасширения);

	Результат = Новый СписокМассив();

	Для Каждого Метод Из ОпределениеРасширения.Методы() Цикл

		Аннотации = АннотацииПерехвата(Метод);

		Если Аннотации.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Аннотации.Количество() > 1 Тогда
			ВызватьИсключение СтрШаблон(
				"Метод %1 расширения %2 помечен несколькими аннотациями перехвата. Один метод перехватывает один метод",
				Метод.Имя,
				ОпределениеРасширения.Имя()
			);
		КонецЕсли;

		Аннотация = Аннотации[0];
		Вид = ВидПерехвата(Аннотация.Имя);

		ОбъектАннотации = Поделка.ПолучитьОпределениеАннотации(Вид).СоздатьОбъектАннотации(Аннотация);

		Если Вид <> Вместо() И Метод.ЭтоФункция Тогда
			ВызватьИсключение СтрШаблон(
				"Метод %1 расширения %2 с аннотацией &%3 должен быть процедурой",
				Метод.Имя,
				ОпределениеРасширения.Имя(),
				Вид
			);
		КонецЕсли;

		ПараметрыПоЗначению = Новый Массив;
		Для Каждого Параметр Из Метод.Параметры Цикл
			ПараметрыПоЗначению.Добавить(Параметр.ПоЗначению);
		КонецЦикла;

		Перехват = Новый Структура;
		Перехват.Вставить("Вид", Вид);
		Перехват.Вставить("ИмяМетода", ОбъектАннотации.ИмяМетода());
		Перехват.Вставить("МетодРасширения", Метод.Имя);
		Перехват.Вставить("КоличествоПараметров", Метод.Параметры.Количество());
		Перехват.Вставить("ПараметрыПоЗначению", ПараметрыПоЗначению);
		Перехват.Вставить("ЭтоФункция", Метод.ЭтоФункция);

		Результат.Добавить(Перехват);

	КонецЦикла;

	ПроверитьНаборыПерехватов(ОпределениеРасширения, Результат);

	Возврат Результат;

КонецФункции

// Как в 1С, одно расширение перехватывает метод одним из наборов:
// &Перед, &После, &Вместо или &Перед вместе с &После.
Процедура ПроверитьНаборыПерехватов(ОпределениеРасширения, Перехваты)

	ВидыПоМетодам = Новый Соответствие;

	Для Каждого Перехват Из Перехваты Цикл

		Ключ = НРег(Перехват.ИмяМетода);
		Виды = ВидыПоМетодам.Получить(Ключ);

		Если Виды = Неопределено Тогда
			Виды = Новый Массив;
			ВидыПоМетодам.Вставить(Ключ, Виды);
		КонецЕсли;

		Виды.Добавить(Перехват.Вид);

		ЕстьПовтор = Виды.Количество() > 1 И Виды.Найти(Перехват.Вид) < Виды.ВГраница();
		ВместоНеОдно = Виды.Количество() > 1 И Виды.Найти(Вместо()) <> Неопределено;

		Если Не ЕстьПовтор И Не ВместоНеОдно Тогда
			Продолжить;
		КонецЕсли;

		АннотацииНабора = Новый Массив;
		Для Каждого Вид Из Виды Цикл
			АннотацииНабора.Добавить("&" + Вид);
		КонецЦикла;

		ВызватьИсключение СтрШаблон(
			"Расширение %1 перехватывает метод %2 аннотациями %3."
			+ " Допустимы &Перед, &После, &Вместо или &Перед вместе с &После",
			ОпределениеРасширения.Имя(),
			Перехват.ИмяМетода,
			СтрСоединить(АннотацииНабора, ", ")
		);

	КонецЦикла;

КонецПроцедуры

// Метод без Экспорт декоратор вызвать не сможет, а ОпределениеЖелудя.Методы() его не видит,
// поэтому без этой проверки перехват молча не применился бы.
Процедура ПроверитьНеэкспортныеМетоды(ОпределениеРасширения)

	ВсеМетоды = ОпределениеРасширения.РефлекторОбъекта().ПолучитьТаблицуМетодов(Неопределено, Ложь);

	Для Каждого Метод Из ВсеМетоды Цикл

		Если Метод.Экспорт Тогда
			Продолжить;
		КонецЕсли;

		Аннотации = АннотацииПерехвата(Метод);

		Если Аннотации.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ВызватьИсключение СтрШаблон(
			"Метод %1 расширения %2 с аннотацией &%3 должен быть экспортным",
			Метод.Имя,
			ОпределениеРасширения.Имя(),
			ВидПерехвата(Аннотации[0].Имя)
		);

	КонецЦикла;

КонецПроцедуры

Функция АннотацииПерехвата(Метод)

	Результат = Новый Массив;

	Для Каждого Аннотация Из Метод.Аннотации Цикл
		Если ВидПерехвата(Аннотация.Имя) <> Неопределено Тогда
			Результат.Добавить(Аннотация);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Каноническое имя вида перехвата: имена аннотаций сравниваются без учёта регистра.
Функция ВидПерехвата(ИмяАннотации)

	Для Каждого Вид Из ВидыПерехвата Цикл
		Если ВРег(Вид) = ВРег(ИмяАннотации) Тогда
			Возврат Вид;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

ВидыПерехвата = Новый Массив;
ВидыПерехвата.Добавить(Перед());
ВидыПерехвата.Добавить(После());
ВидыПерехвата.Добавить(Вместо());
