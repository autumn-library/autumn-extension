#Использовать decorator
#Использовать collectionos
#Использовать logos
#Использовать reflector

// Применяет к желудям расширения.
//
// Желудь-одиночка, общий для приёмки и напильников: приёмка передаёт ему описание каждого
// расширения, а каждый напильник применяет расширения своего назначения. Спецификация
// "Инициализация" - чтобы применитель можно было получить, пока поделка создаётся,
// и чтобы к нему самому не применялись напильники.
//
// Каждое расширение - отдельный слой декоратора, поэтому расширения ведут себя как вложенные:
// перехватчики "Перед" расширения, применённого позже, отрабатывают раньше, "После" - позже,
// а "Вместо" заменяет всё, что было применено до него, вместе с самим методом.
//
// Метод "Вместо" может последним параметром получить продолжение вызова - Действие над этим же
// методом того, что построено до расширения (Декоратор_ИсходныйОбъект). Действие вызывает только
// экспортные методы, а продолжение перехватчика "Вместо" в объединённом декораторе - приватный
// метод (Декоратор_ПродолжитьВызов() заменяется его вызовом только в теле перехватчика). Поэтому
// слой, в котором расширение получает продолжение, строится отдельным объектом: ОбъединятьСлои(Ложь).
// Остальные слои объединяются, как обычно: "Вместо" без продолжения и в объединённом декораторе
// отсекает всё, что под ним.

#Область ОписаниеПеременных

// Поделка - Контекст приложения.
Перем _Поделка;

// КартаСоответствие - Описания расширений по назначению и расширяемому желудю. Заполняется,
// пока создаётся поделка, дальше только читается - поэтому желуди можно создавать из разных потоков:
//  * Ключ - Строка - Назначение, см. НазначенияРасширений
//  * Значение - КартаСоответствие:
//    ** Ключ - Строка - Имя или прозвище расширяемого желудя
//    ** Значение - Массив из см. РасширенияЖелудейСлужебный.ОписаниеРасширения
Перем _РасширенияПоНазначению;

// Рефлектор - Кэш инстанса рефлектора.
Перем _Рефлектор;

// Лог - Логгер применения расширений.
Перем _Лог;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Регистрирует расширение, см. ПриемкаРасширение.
//
// Параметры:
//   Описание - см. РасширенияЖелудейСлужебный.ОписаниеРасширения
//
Процедура ДобавитьРасширение(Описание) Экспорт

	_РасширенияПоНазначению
		.ВычислитьЕслиОтсутствует(Описание.Назначение, "(Назначение) -> Новый КартаСоответствие()")
		.Получить()
		.ВычислитьЕслиОтсутствует(Описание.Цель, "(Цель) -> Новый Массив()")
		.Получить()
		.Добавить(Описание);

	_Лог.Отладка(
		"Расширение %1 (%2) зарегистрировано для желудя %3",
		Описание.Имя,
		Описание.Назначение,
		Описание.Цель
	);

КонецПроцедуры

// Применяет к желудю расширения одного назначения.
//
// Параметры:
//   Желудь - Произвольный - Экземпляр желудя
//   ОпределениеЖелудя - ОпределениеЖелудя - Определение желудя
//   Назначение - Строка - Назначение применяемых расширений, см. НазначенияРасширений
//
//  Возвращаемое значение:
//   Произвольный - Желудь, если расширений нет, иначе декоратор над ним
//
Функция Применить(Желудь, ОпределениеЖелудя, Назначение) Экспорт

	Если Желудь = Неопределено Тогда
		Возврат Желудь;
	КонецЕсли;

	Результат = Желудь;

	Для Каждого Описание Из РасширенияЖелудя(ОпределениеЖелудя, Назначение) Цикл
		Результат = ПрименитьРасширение(Результат, ОпределениеЖелудя, Описание);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Расширения желудя в порядке применения: по порядку расширения, при равном порядке - по имени.
Функция РасширенияЖелудя(ОпределениеЖелудя, Назначение)

	РасширенияНазначения = _РасширенияПоНазначению.Получить(Назначение);

	Если РасширенияНазначения.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	РасширенияПоЦели = РасширенияНазначения.Получить();
	Найденные = Неопределено;

	Для Каждого Прозвище Из ОпределениеЖелудя.Прозвища() Цикл

		ОписанияЦели = РасширенияПоЦели.Получить(Прозвище);

		Если ОписанияЦели.Пустой() Тогда
			Продолжить;
		КонецЕсли;

		Если Найденные = Неопределено Тогда
			Найденные = Новый СписокМассив();
		КонецЕсли;

		Для Каждого Описание Из ОписанияЦели.Получить() Цикл

			// Прозвище желудя может совпасть с его именем
			Если Не Найденные.Содержит(Описание) Тогда
				Найденные.Добавить(Описание);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Если Найденные = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Найденные.Сортировать(
		"(Первое, Второе) -> {
		|	Если Первое.Порядок <> Второе.Порядок Тогда
		|		Возврат ?(Первое.Порядок > Второе.Порядок, 1, -1);
		|	ИначеЕсли Первое.Имя <> Второе.Имя Тогда
		|		Возврат ?(Первое.Имя > Второе.Имя, 1, -1);
		|	КонецЕсли;
		|	Возврат 0;
		|}"
	);

	Возврат Найденные.ВМассив();

КонецФункции

Функция ПрименитьРасширение(Объект, ОпределениеЖелудя, Описание)

	Расширение = _Поделка.НайтиЖелудь(Описание.Имя);

	Если Расширение = Неопределено Тогда
		// Поделка не выбрасывает ошибку создания желудя, а пишет её в лог
		ВызватьИсключение СтрШаблон(
			"Не удалось создать расширение %1 желудя %2, причина записана в лог oscript.lib.autumn.application.context",
			Описание.Имя,
			ОпределениеЖелудя.Имя()
		);
	КонецЕсли;

	// Методы самого объекта, а не ОпределениеЖелудя.Методы(): объект может быть уже декоратором
	// с методами, добавленными расширениями до этого, а определение не знает и неэкспортных методов
	МетодыОбъекта = _Рефлектор.ПолучитьТаблицуМетодов(Объект);
	ИмяПоля       = СвободноеИмяПоля(Объект, Описание.Имя);

	Построитель = Новый ПостроительДекоратора(Объект)
		.Поле(Новый Поле(ИмяПоля).ЗначениеПоУмолчанию(Расширение));

	ЕстьПродолжение = Ложь;

	Для Каждого Перехват Из Описание.Перехваты Цикл

		МетодЦели = МетодЦели(МетодыОбъекта, Перехват, Описание, ОпределениеЖелудя);

		ДополнительныйПараметр = ПроверитьПараметры(МетодЦели, Перехват, Описание, ОпределениеЖелудя);

		Построитель.Перехватчик(
			Новый Перехватчик(ОбработкаДекоратора.ИмяМетодаДекоратора(МетодЦели.Имя))
				.ТипПерехватчика(ТипПерехватчика(Перехват.Вид))
				.Тело(ТелоПерехватчика(ИмяПоля, Перехват, МетодЦели, ДополнительныйПараметр))
		);

		Если ДополнительныйПараметр И Перехват.Вид = РасширенияЖелудейСлужебный.Вместо() Тогда
			ЕстьПродолжение = Истина;
		КонецЕсли;

	КонецЦикла;

	ДобавитьМетодыРасширения(Построитель, МетодыОбъекта, Расширение, ИмяПоля, Описание, ОпределениеЖелудя);

	Если ЕстьПродолжение Тогда
		Построитель.ОбъединятьСлои(Ложь);
	КонецЕсли;

	_Лог.Отладка(
		"Желудь %1: применяется расширение %2 (%3, порядок %4, отдельный объект: %5)",
		ОпределениеЖелудя.Имя(),
		Описание.Имя,
		Описание.Назначение,
		Описание.Порядок,
		ЕстьПродолжение
	);

	Возврат Построитель.Построить();

КонецФункции

// Экспортные методы расширения без аннотаций перехвата становятся методами желудя, как в 1С:
// слой получает метод с той же сигнатурой и аннотациями, который вызывает метод расширения.
Процедура ДобавитьМетодыРасширения(Построитель, МетодыОбъекта, Расширение, ИмяПоля, Описание, ОпределениеЖелудя)

	Если Описание.ДобавляемыеМетоды.Пусто() Тогда
		Возврат;
	КонецЕсли;

	МетодыРасширения = _Рефлектор.ПолучитьТаблицуМетодов(Расширение);

	Для Каждого ИмяМетода Из Описание.ДобавляемыеМетоды Цикл

		// Декоратор тоже не дал бы построить слой, но его ошибка не называет расширение
		Для Каждого МетодОбъекта Из МетодыОбъекта Цикл
			Если МетодОбъекта.Экспорт И НРег(МетодОбъекта.Имя) = НРег(ИмяМетода) Тогда
				ВызватьИсключение СтрШаблон(
					"Метод %1 расширения %2 не может стать методом желудя %3: у желудя уже есть метод с таким именем."
					+ " Чтобы перехватить его, пометьте метод расширения аннотацией &Перед, &После или &Вместо",
					ИмяМетода,
					Описание.Имя,
					ОпределениеЖелудя.Имя()
				);
			КонецЕсли;
		КонецЦикла;

		Построитель.Метод(ДобавляемыйМетод(ИмяПоля, МетодыРасширения.Найти(ИмяМетода, "Имя")));

	КонецЦикла;

КонецПроцедуры

Функция ДобавляемыйМетод(ИмяПоля, МетодРасширения)

	Метод = Новый Метод(МетодРасширения.Имя).Публичный();

	Если Не МетодРасширения.ЭтоФункция Тогда
		Метод.ЭтоПроцедура();
	КонецЕсли;

	Для Каждого Аннотация Из Коллекция(МетодРасширения.Аннотации) Цикл
		Метод.Аннотация(КопияАннотации(Аннотация));
	КонецЦикла;

	ИменаПараметров = Новый Массив;

	Для Каждого ОписаниеПараметра Из МетодРасширения.Параметры Цикл

		Параметр = Новый ПараметрМетода(ОписаниеПараметра.Имя);

		Если ОписаниеПараметра.ПоЗначению Тогда
			Параметр.ПоЗначению();
		КонецЕсли;

		Если ОписаниеПараметра.ЕстьЗначениеПоУмолчанию Тогда
			Параметр.ЗначениеПоУмолчанию(ОписаниеПараметра.ЗначениеПоУмолчанию);
		КонецЕсли;

		Для Каждого Аннотация Из Коллекция(ОписаниеПараметра.Аннотации) Цикл
			Параметр.Аннотация(КопияАннотации(Аннотация));
		КонецЦикла;

		Метод.Параметр(Параметр);
		ИменаПараметров.Добавить(ОписаниеПараметра.Имя);

	КонецЦикла;

	Вызов = СтрШаблон("%1.%2(%3)", ИмяПоля, МетодРасширения.Имя, СтрСоединить(ИменаПараметров, ", "));

	Метод.ТелоМетода(?(МетодРасширения.ЭтоФункция, "Возврат " + Вызов + ";", Вызов + ";"));

	Возврат Метод;

КонецФункции

// Рефлектор вместо пустой таблицы аннотаций может вернуть Неопределено.
Функция Коллекция(Значение)
	Возврат ?(Значение = Неопределено, Новый Массив, Значение);
КонецФункции

Функция КопияАннотации(ОписаниеАннотации)

	Аннотация = Новый Аннотация(ОписаниеАннотации.Имя);

	Если ЗначениеЗаполнено(ОписаниеАннотации.Параметры) Тогда
		Для Каждого ПараметрАннотации Из ОписаниеАннотации.Параметры Цикл
			Аннотация.Параметр(ПараметрАннотации.Значение, ПараметрАннотации.Имя);
		КонецЦикла;
	КонецЕсли;

	Возврат Аннотация;

КонецФункции

// Экспортный метод объекта, который перехватывает метод расширения. Методы с зарезервированными
// именами декоратор переименовывает, поэтому у объекта-декоратора метод может называться иначе.
Функция МетодЦели(МетодыОбъекта, Перехват, Описание, ОпределениеЖелудя)

	ВозможныеИмена = Новый Массив;
	ВозможныеИмена.Добавить(НРег(Перехват.ИмяМетода));
	ВозможныеИмена.Добавить(НРег(ОбработкаДекоратора.ИмяМетодаДекоратора(Перехват.ИмяМетода)));

	Для Каждого Метод Из МетодыОбъекта Цикл

		Если ВозможныеИмена.Найти(НРег(Метод.Имя)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Не Метод.Экспорт Тогда
			ВызватьИсключение СтрШаблон(
				"Метод %1 желудя %2 не экспортный, его нельзя перехватить методом %3 расширения %4",
				Метод.Имя,
				ОпределениеЖелудя.Имя(),
				Перехват.МетодРасширения,
				Описание.Имя
			);
		КонецЕсли;

		Возврат Метод;

	КонецЦикла;

	ВызватьИсключение СтрШаблон(
		"У желудя %1 нет метода %2, который перехватывает метод %3 расширения %4",
		ОпределениеЖелудя.Имя(),
		Перехват.ИмяМетода,
		Перехват.МетодРасширения,
		Описание.Имя
	);

КонецФункции

// Проверяет, что метод расширения подходит перехватываемому методу.
//
//  Возвращаемое значение:
//   Булево - Истина, если методу расширения последним параметром передаётся результат функции ("После")
//            или продолжение вызова ("Вместо")
//
Функция ПроверитьПараметры(МетодЦели, Перехват, Описание, ОпределениеЖелудя)

	Если Перехват.Вид = РасширенияЖелудейСлужебный.Вместо() И Перехват.ЭтоФункция <> МетодЦели.ЭтоФункция Тогда
		ВызватьИсключение СтрШаблон(
			"Метод %1 расширения %2 заменяет %3 %4 желудя %5 и должен быть %6",
			Перехват.МетодРасширения,
			Описание.Имя,
			?(МетодЦели.ЭтоФункция, "функцию", "процедуру"),
			МетодЦели.Имя,
			ОпределениеЖелудя.Имя(),
			?(МетодЦели.ЭтоФункция, "функцией", "процедурой")
		);
	КонецЕсли;

	КоличествоПараметровЦели = МетодЦели.Параметры.Количество();

	Если Перехват.КоличествоПараметров = КоличествоПараметровЦели Тогда
		ПроверитьПередачуПоЗначению(МетодЦели, Перехват, Описание, ОпределениеЖелудя);
		Возврат Ложь;
	КонецЕсли;

	ОписаниеДополнительного = ОписаниеДополнительногоПараметра(МетодЦели, Перехват);

	Если ОписаниеДополнительного <> Неопределено И Перехват.КоличествоПараметров = КоличествоПараметровЦели + 1 Тогда
		ПроверитьПередачуПоЗначению(МетодЦели, Перехват, Описание, ОпределениеЖелудя);
		Возврат Истина;
	КонецЕсли;

	ОжидаемоеКоличество = Формат(КоличествоПараметровЦели, "ЧН=0; ЧГ=0");

	Если ОписаниеДополнительного <> Неопределено Тогда
		ОжидаемоеКоличество = СтрШаблон(
			"%1 или %2 (последний - %3)",
			ОжидаемоеКоличество,
			Формат(КоличествоПараметровЦели + 1, "ЧГ=0"),
			ОписаниеДополнительного
		);
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Метод %1 расширения %2 перехватывает метод %3 желудя %4: параметров у него %5, а должно быть %6",
		Перехват.МетодРасширения,
		Описание.Имя,
		МетодЦели.Имя,
		ОпределениеЖелудя.Имя(),
		Формат(Перехват.КоличествоПараметров, "ЧН=0; ЧГ=0"),
		ОжидаемоеКоличество
	);

КонецФункции

// Что может получить метод расширения последним параметром, сверх параметров перехватываемого метода.
//
//  Возвращаемое значение:
//   Строка - Описание дополнительного параметра для текста ошибки
//   Неопределено - Дополнительного параметра нет
//
Функция ОписаниеДополнительногоПараметра(МетодЦели, Перехват)

	Если Перехват.Вид = РасширенияЖелудейСлужебный.Вместо() Тогда
		Возврат "продолжение вызова";
	ИначеЕсли Перехват.Вид = РасширенияЖелудейСлужебный.После() И МетодЦели.ЭтоФункция Тогда
		Возврат "результат функции";
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Как в 1С, параметры метода расширения передаются по значению так же, как параметры
// перехватываемого метода: иначе присваивание параметру в расширении молча не дошло бы
// до метода или, наоборот, дошло бы там, где его не ждут.
Процедура ПроверитьПередачуПоЗначению(МетодЦели, Перехват, Описание, ОпределениеЖелудя)

	Для Индекс = 0 По МетодЦели.Параметры.Количество() - 1 Цикл

		ПараметрЦели = МетодЦели.Параметры[Индекс];

		Если ПараметрЦели.ПоЗначению = Перехват.ПараметрыПоЗначению[Индекс] Тогда
			Продолжить;
		КонецЕсли;

		ВызватьИсключение СтрШаблон(
			"Метод %1 расширения %2 перехватывает метод %3 желудя %4: параметр %5 %6 передаваться по значению (Знач), как у перехватываемого метода",
			Перехват.МетодРасширения,
			Описание.Имя,
			МетодЦели.Имя,
			ОпределениеЖелудя.Имя(),
			Формат(Индекс + 1, "ЧГ=0"),
			?(ПараметрЦели.ПоЗначению, "должен", "не должен")
		);

	КонецЦикла;

КонецПроцедуры

Функция ТипПерехватчика(ВидПерехвата)

	Если ВидПерехвата = РасширенияЖелудейСлужебный.Перед() Тогда
		Возврат ТипыПерехватчиковМетода.Перед;
	ИначеЕсли ВидПерехвата = РасширенияЖелудейСлужебный.После() Тогда
		Возврат ТипыПерехватчиковМетода.После;
	КонецЕсли;

	Возврат ТипыПерехватчиковМетода.Вместо;

КонецФункции

// Тело перехватчика - вызов метода расширения с параметрами перехватываемого метода.
// Параметры передаются по ссылке, поэтому изменения доходят до перехватываемого метода.
Функция ТелоПерехватчика(ИмяПоля, Перехват, МетодЦели, ДополнительныйПараметр)

	Аргументы = Новый Массив;

	Для Каждого Параметр Из МетодЦели.Параметры Цикл
		Аргументы.Добавить(ОбработкаДекоратора.ИмяПараметраДекоратора(Параметр.Имя));
	КонецЦикла;

	ЭтоВместо = Перехват.Вид = РасширенияЖелудейСлужебный.Вместо();

	Если ДополнительныйПараметр И ЭтоВместо Тогда
		// Продолжение - этот же метод того, что построено до расширения: слой с продолжением
		// строится отдельным объектом, см. ПрименитьРасширение
		Аргументы.Добавить(СтрШаблон(
			"Новый Действие(%1, ""%2"")",
			Константы_Декоратор.Поле_ИнстансОбъекта,
			МетодЦели.Имя
		));
	ИначеЕсли ДополнительныйПараметр Тогда
		Аргументы.Добавить("Декоратор_ВозвращаемоеИзМетодаЗначение");
	КонецЕсли;

	Вызов = СтрШаблон("%1.%2(%3);", ИмяПоля, Перехват.МетодРасширения, СтрСоединить(Аргументы, ", "));

	// Тело перехватчика "Вместо" декоратор выносит в метод того же вида, что перехватываемый,
	// поэтому результат функции возвращается обычным Возврат
	Если ЭтоВместо И МетодЦели.ЭтоФункция Тогда
		Возврат "Возврат " + Вызов;
	КонецЕсли;

	Возврат Вызов;

КонецФункции

// Имя поля декоратора, в котором хранится экземпляр расширения. Не совпадает с полями объекта:
// при объединении слоёв одноимённые поля - ошибка построения декоратора.
Функция СвободноеИмяПоля(Объект, ИмяРасширения)

	ЗанятыеИмена = Новый Соответствие;

	Для Каждого Свойство Из _Рефлектор.ПолучитьТаблицуСвойств(Объект, Истина) Цикл
		ЗанятыеИмена.Вставить(НРег(Свойство.Имя), Истина);
	КонецЦикла;

	Основа  = "Расширение_" + Идентификатор(ИмяРасширения);
	ИмяПоля = Основа;
	Номер   = 1;

	Пока ЗанятыеИмена.Получить(НРег(ИмяПоля)) <> Неопределено Цикл
		Номер   = Номер + 1;
		ИмяПоля = Основа + "_" + Формат(Номер, "ЧГ=0");
	КонецЦикла;

	Возврат ИмяПоля;

КонецФункции

// Имя желудя может содержать символы, недопустимые в имени переменной.
Функция Идентификатор(Имя)

	ДопустимыеСимволы = "abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789_";

	Части = Новый Массив;

	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Символ = Сред(Имя, Позиция, 1);
		Части.Добавить(?(СтрНайти(ДопустимыеСимволы, НРег(Символ)) = 0, "_", Символ));
	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

#КонецОбласти

#Область Инициализация

// Параметры:
//   Поделка - Поделка - Контекст приложения
//
&Желудь
&Спецификация("Инициализация")
Процедура ПриСозданииОбъекта(&Пластилин Поделка)

	_Поделка                = Поделка;
	_РасширенияПоНазначению = Новый КартаСоответствие();
	_Рефлектор              = Новый Рефлектор;
	_Лог                    = Логирование.ПолучитьЛог("oscript.lib.autumn.extension");

КонецПроцедуры

#КонецОбласти
