#Использовать "../internal"

// Поделка - Контекст приложения.
Перем _Поделка;

// ПрименительРасширений - Получает описания расширений.
Перем _Применитель;

// Читает и проверяет расширение при добавлении его определения и передаёт описание применителю.
// Ошибка в самом классе расширения останавливает запуск приложения.
//
// То, что зависит от расширяемого желудя (есть ли у него метод, совпадают ли параметры),
// проверяется при применении расширения.
//
// Параметры:
//   ОпределениеЖелудя - ОпределениеЖелудя - Добавленное определение желудя
//
Процедура ПриДобавленииОпределенияЖелудя(Знач ОпределениеЖелудя) Экспорт

	Если Не РасширенияЖелудейСлужебный.ЭтоРасширение(ОпределениеЖелудя) Тогда
		Возврат;
	КонецЕсли;

	_Применитель.ДобавитьРасширение(РасширенияЖелудейСлужебный.ОписаниеРасширения(ОпределениеЖелудя, _Поделка));

КонецПроцедуры

// Приемка расширений, см. АннотацияРасширение.
//
// К приёмке, как к любому желудю времени инициализации, ОСень прилепляет только детальки
// и поделку, поэтому применитель берётся из поделки. Его определение к этому моменту уже есть:
// класс применителя подключается через #Использовать "../internal" выше, поэтому его тип
// регистрируется и сканируется поделкой раньше приёмки.
//
// Параметры:
//   Поделка - Поделка - Контекст приложения
//
&Приемка
Процедура ПриСозданииОбъекта(&Пластилин Поделка)
	_Поделка     = Поделка;
	_Применитель = Поделка.НайтиЖелудь("ПрименительРасширений");
КонецПроцедуры
