#Использовать "../internal"

Перем _ИмяМетода;

// Имя перехватываемого метода расширяемого желудя.
//
//  Возвращаемое значение:
//   Строка
//
Функция ИмяМетода() Экспорт
	Возврат _ИмяМетода;
КонецФункции

// Метод расширения выполняется вместо метода расширяемого желудя - как `&Вместо` в расширениях 1С.
//
// Метод расширения - экспортный метод того же вида (функция или процедура) и с теми же
// параметрами, что у перехватываемого метода. Результат функции расширения становится
// результатом вызова.
//
// Чтобы вызвать перехватываемый метод, добавьте методу расширения последний параметр -
// продолжение вызова, `Действие`: `ПродолжитьВызов.Выполнить(<Параметры>)`. Вызов проходит
// через расширения, применённые раньше этого, и через сам метод. Параметры передаются
// по ссылке; для пропущенных метод возьмёт свои значения по умолчанию. Продолжение можно
// не вызывать, вызвать с другими значениями параметров или несколько раз. Без этого
// параметра метод расширения заменяет перехватываемый метод целиком.
//
// Размещается над экспортным методом класса с аннотацией `&Расширение`.
//
// Параметры:
//   Значение - Строка - Имя перехватываемого метода.
//
// Пример:
// &Вместо("Посчитать")
// Функция ПосчитатьСКэшем(А, Б, ПродолжитьВызов) Экспорт
// 	Ключ = СтрШаблон("%1:%2", А, Б);
// 	Если Кэш[Ключ] = Неопределено Тогда
// 		Кэш[Ключ] = ПродолжитьВызов.Выполнить(А, Б);
// 	КонецЕсли;
// 	Возврат Кэш[Ключ];
// КонецФункции
//
&Аннотация("Вместо")
Процедура ПриСозданииОбъекта(Значение)
	_ИмяМетода = РасширенияЖелудейСлужебный.ИмяПерехватываемогоМетода(Значение, "Вместо");
КонецПроцедуры
