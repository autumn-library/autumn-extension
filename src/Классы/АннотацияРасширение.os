Перем _Цель;
Перем _Назначение;

// Имя или прозвище расширяемого желудя.
//
//  Возвращаемое значение:
//   Строка
//
Функция Цель() Экспорт
	Возврат _Цель;
КонецФункции

// Назначение расширения, одно из значений модуля НазначенияРасширений.
//
//  Возвращаемое значение:
//   Строка
//
Функция Назначение() Экспорт
	Возврат _Назначение;
КонецФункции

// Помечает класс как расширение желудя - аналог расширения конфигурации 1С.
//
// Методы расширения, помеченные аннотациями `&Перед`, `&После` и `&Вместо`, перехватывают
// экспортные методы расширяемого желудя, имена которых указаны в этих аннотациях. Остальные
// экспортные методы расширения становятся методами расширяемого желудя, как будто объявлены в нём.
//
// Расширение живёт вместе с расширяемым желудем: у одиночки оно одно, у компанейского желудя -
// своё у каждого экземпляра. В конструктор и поля расширения можно прилеплять желуди и детальки.
//
// Каждое `&Расширение` дополнительно имеет `&Желудь`, `&Прозвище("Расширение")`
// и `&Характер("Компанейский")`, поэтому отдельно помечать класс `&Желудь` не нужно,
// а `&Характер` указывать нельзя.
//
// Размещается над конструктором класса.
//
// Параметры:
//   Значение - Строка - Имя или прозвище расширяемого желудя. Расширение применяется ко всем желудям,
//                       у которых есть такое имя или прозвище.
//   Назначение - Строка - Назначение расширения, одно из значений модуля НазначенияРасширений:
//                         "Исправление", "Адаптация" или "Дополнение". Расширения применяются в этом
//                         порядке, внутри одного назначения - по `&Порядок` расширения. Каждое следующее
//                         расширение оборачивает предыдущие.
//   Имя - Строка - Имя желудя расширения. По умолчанию - имя типа.
//
// Пример:
// &Расширение("Калькулятор", Назначение = "Исправление")
// Процедура ПриСозданииОбъекта()
// КонецПроцедуры
//
&Аннотация("Расширение")
&Желудь
&Прозвище("Расширение")
&Характер("Компанейский")
Процедура ПриСозданииОбъекта(
	Значение,
	Назначение = "Дополнение",
	&ПсевдонимДля(Аннотация = "Желудь", Параметр = "Значение") Имя = ""
)

	Если ТипЗнч(Значение) <> Тип("Строка") Или ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "В аннотации &Расширение не указано имя расширяемого желудя";
	КонецЕсли;

	Если Не НазначенияРасширений.ЭтоНазначениеРасширения(Назначение) Тогда
		ВызватьИсключение СтрШаблон(
			"Неизвестное назначение расширения ""%1"". Допустимые значения: %2",
			Назначение,
			// СтрСоединить не принимает ФиксированныйМассив
			СтрСоединить(Новый Массив(НазначенияРасширений.ВсеНазначения()), ", ")
		);
	КонецЕсли;

	_Цель       = Значение;
	_Назначение = Назначение;

КонецПроцедуры
