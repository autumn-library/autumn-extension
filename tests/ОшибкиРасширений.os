#КонецОбласти

Процедура ПроверитьОшибкуСозданияПоделки(ОжидаемыйТекст)

	БылаОшибка = Ложь;

	Попытка
		НоваяПоделка = Новый Поделка(); // BSLLS:UnusedLocalVariable-off
	Исключение
		БылаОшибка = Истина;
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит(ОжидаемыйТекст);
	КонецПопытки;

	Ожидаем.Что(БылаОшибка, "Поделка создалась с ошибочным расширением").ЭтоИстина();

КонецПроцедуры

// Поделка.НайтиЖелудь ошибки создания желудя только логирует и возвращает Неопределено,
// поэтому напильник проверяется напрямую
Процедура ПроверитьОшибкуПрименения(Желудь, ОжидаемыйТекст)

	Напильник = Поделка.НайтиЖелудь("ОбработкаНапильникомРасширенияДополнение");

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить(Желудь);
	ПараметрыМетода.Добавить(Поделка.ПолучитьОпределениеЖелудя(Строка(ТипЗнч(Желудь))));

	Ожидаем.Что(Напильник)
		.Метод("ОбработатьЖелудь", ПараметрыМетода)
		.ВыбрасываетИсключение(ОжидаемыйТекст);

КонецПроцедуры
