// BSLLS:MissingVariablesDescription-off

Перем Кэш;

&Вместо("Сложить")
Функция СложитьСКэшем(А, Б, ПродолжитьВызов) Экспорт

	Ключ = СтрШаблон("%1+%2", А, Б);

	Если Кэш[Ключ] = Неопределено Тогда
		Кэш[Ключ] = ПродолжитьВызов.Выполнить(А, Б);
	КонецЕсли;

	Возврат Кэш[Ключ];

КонецФункции

// Продолжение процедуры - инструкция, параметры можно подменить
&Вместо("Записать")
Процедура ЗаписатьГромко(Значение, ПродолжитьВызов) Экспорт
	ПродолжитьВызов.Выполнить(ВРег(Значение) + "!");
КонецПроцедуры

// Параметры передаются по ссылке в обе стороны: исходный метод обрезает пробелы,
// расширение видит это и меняет значение для вызывающего
&Вместо("Нормализовать")
Процедура НормализоватьВВерхнийРегистр(Значение, ПродолжитьВызов) Экспорт
	ПродолжитьВызов.Выполнить(Значение);
	Значение = ВРег(Значение);
КонецПроцедуры

// Пропущенный параметр продолжения калькулятор заполнит своим значением по умолчанию
&Вместо("Умножить")
Функция УмножитьНаМножительПоУмолчанию(А, Б, ПродолжитьВызов) Экспорт
	Возврат ПродолжитьВызов.Выполнить(А);
КонецФункции

// Методы без аннотаций перехвата становятся методами калькулятора
&Отладочный(Уровень = "подробно")
Функция РазмерКэша() Экспорт
	Возврат Кэш.Количество();
КонецФункции

Функция Округлить(Знач Значение, &Единица("знаков") Точность = 2) Экспорт
	Возврат Окр(Значение, Точность);
КонецФункции

Процедура СброситьКэш() Экспорт
	Кэш.Очистить();
КонецПроцедуры

&Расширение("Калькулятор")
Процедура ПриСозданииОбъекта()
	Кэш = Новый Соответствие;
КонецПроцедуры
