// BSLLS:MissingVariablesDescription-off

Перем Журнал;

Функция Отгрузить(Товар, Количество) Экспорт
	Журнал.Записать(СтрШаблон("Склад.Отгрузить %1 %2", Товар, Количество));
	Возврат Количество;
КонецФункции

Процедура Принять(Товар, Количество) Экспорт
	Журнал.Записать(СтрШаблон("Склад.Принять %1 %2", Товар, Количество));
КонецПроцедуры

Функция Остаток(Товар) Экспорт
	Журнал.Записать("Склад.Остаток " + Товар);
	Возврат 0;
КонецФункции

Процедура Списать(Товар) Экспорт
	ВызватьИсключение "Списание запрещено: " + Товар;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ЖурналВызовов)
	Журнал = ЖурналВызовов;
КонецПроцедуры
