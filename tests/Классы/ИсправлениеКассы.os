// BSLLS:MissingVariablesDescription-off

Перем Журнал;

&Перед("Оплатить")
Процедура ПередОплатой(Сумма) Экспорт
	Журнал.Записать("Исправление.Перед " + Сумма);
КонецПроцедуры

&После("Оплатить")
Процедура ПослеОплаты(Сумма) Экспорт
	Журнал.Записать("Исправление.После " + Сумма);
КонецПроцедуры

// Становится методом кассы - и его можно перехватить расширением, применённым позже
Функция Валюта() Экспорт
	Возврат "RUB";
КонецФункции

&Расширение("Касса", Назначение = "Исправление")
Процедура ПриСозданииОбъекта(&Пластилин ЖурналВызовов)
	Журнал = ЖурналВызовов;
КонецПроцедуры
