#Использовать decorator

// Сторонний напильник, как у autumn-opentelemetry: применяется после напильников расширений
// и объединяет свой слой поверх них

Перем _Поделка;

Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт

	Возврат Новый ПостроительДекоратора(Желудь)
		.Поле(Новый Поле("Трассировка_Журнал").ЗначениеПоУмолчанию(_Поделка.НайтиЖелудь("ЖурналВызовов")))
		.Перехватчик(Новый Перехватчик("Оплатить")
			.ТипПерехватчика(ТипыПерехватчиковМетода.Перед)
			.Тело("Трассировка_Журнал.Записать(""Трассировка.Перед "" + Сумма);"))
		.Построить();

КонецФункции

&Напильник(ПрименяетсяТолькоНа = "Касса")
&Порядок(400)
Процедура ПриСозданииОбъекта(&Пластилин Поделка)
	_Поделка = Поделка;
КонецПроцедуры
