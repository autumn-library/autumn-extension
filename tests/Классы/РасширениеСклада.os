// BSLLS:MissingVariablesDescription-off

Перем Журнал;

// Параметры передаются по ссылке: исходный метод получит удвоенное количество
&Перед("Отгрузить")
Процедура ПередОтгрузкой(Товар, Количество) Экспорт
	Количество = Количество * 2;
КонецПроцедуры

// Последний параметр - результат функции, его можно заменить
&После("Отгрузить")
Процедура ПослеОтгрузки(Товар, Количество, Результат) Экспорт
	Результат = Результат + 1;
КонецПроцедуры

// Без продолжения вызова исходный метод не выполняется
&Вместо("Принять")
Процедура ПринятьБезСклада(Товар, Количество) Экспорт
	Журнал.Записать(СтрШаблон("Расширение.Принять %1 %2", Товар, Количество));
КонецПроцедуры

&Вместо("Остаток")
Функция ОстатокИзРасширения(Товар) Экспорт
	Возврат 42;
КонецФункции

&После("Списать")
Процедура ПослеСписания(Товар) Экспорт
	Журнал.Записать("Расширение.ПослеСписания " + Товар);
КонецПроцедуры

&Расширение("Склад", Назначение = "Исправление")
Процедура ПриСозданииОбъекта(&Пластилин ЖурналВызовов)
	Журнал = ЖурналВызовов;
КонецПроцедуры
