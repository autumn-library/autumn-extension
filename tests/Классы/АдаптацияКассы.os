// BSLLS:MissingVariablesDescription-off

Перем Журнал;

&Вместо("Оплатить")
Функция ОплатитьСАдаптацией(Сумма, ПродолжитьВызов) Экспорт
	Журнал.Записать("Адаптация.Вместо.До " + Сумма);
	Результат = ПродолжитьВызов.Выполнить(Сумма);
	Журнал.Записать("Адаптация.Вместо.После " + Результат);
	Возврат Результат + " (адаптировано)";
КонецФункции

&Расширение("Касса", Назначение = "Адаптация")
Процедура ПриСозданииОбъекта(&Пластилин ЖурналВызовов)
	Журнал = ЖурналВызовов;
КонецПроцедуры
