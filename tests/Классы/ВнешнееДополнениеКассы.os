// BSLLS:MissingVariablesDescription-off

Перем Журнал;

&Перед("Оплатить")
Процедура ПередОплатой(Сумма) Экспорт
	Журнал.Записать("ВнешнееДополнение.Перед " + Сумма);
КонецПроцедуры

&После("Оплатить")
Процедура ПослеОплаты(Сумма) Экспорт
	Журнал.Записать("ВнешнееДополнение.После " + Сумма);
КонецПроцедуры

// Порядок больше, чем у ДополнениеКассы, поэтому применяется после него и оборачивает его,
// хотя по имени шло бы раньше
&Расширение("Касса", Назначение = "Дополнение")
&Порядок(2)
Процедура ПриСозданииОбъекта(&Пластилин ЖурналВызовов)
	Журнал = ЖурналВызовов;
КонецПроцедуры
