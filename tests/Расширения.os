&Пластилин
Перем Поделка;

&ТестовыйНабор
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
&Изолированный
Процедура РасширенияПрименяютсяПоНазначениюИПорядку() Экспорт

	// Дано
	Касса = Поделка.НайтиЖелудь("Касса");

	// Когда
	Результат = Касса.Оплатить(100);

	// Тогда
	Ожидаем.Что(Результат).Равно("чек 100 (адаптировано)");

	ОжидаемыйЖурнал = Новый Массив;
	// Сторонний напильник с порядком 400 оборачивает все расширения
	ОжидаемыйЖурнал.Добавить("Трассировка.Перед 100");
	ОжидаемыйЖурнал.Добавить("ВнешнееДополнение.Перед 100");
	ОжидаемыйЖурнал.Добавить("Дополнение.Перед 100");
	ОжидаемыйЖурнал.Добавить("Адаптация.Вместо.До 100");
	ОжидаемыйЖурнал.Добавить("Исправление.Перед 100");
	ОжидаемыйЖурнал.Добавить("Касса.Оплатить 100");
	ОжидаемыйЖурнал.Добавить("Исправление.После 100");
	ОжидаемыйЖурнал.Добавить("Адаптация.Вместо.После чек 100");
	ОжидаемыйЖурнал.Добавить("Дополнение.После 100");
	ОжидаемыйЖурнал.Добавить("ВнешнееДополнение.После 100");

	Ожидаем.Что(СтрСоединить(Журнал(), Символы.ПС)).Равно(СтрСоединить(ОжидаемыйЖурнал, Символы.ПС));

КонецПроцедуры

&Тест
&Изолированный
Процедура ПриРавномПорядкеРасширенияПрименяютсяПоИмени() Экспорт

	// Дано
	Лампа = Поделка.НайтиЖелудь("Лампа");

	// Когда
	Результат = Лампа.Свет();

	// Тогда
	// ЦветЛампы применён раньше ЯркостьЛампы, поэтому его "После" внутри и отрабатывает первым
	Ожидаем.Что(Результат).Равно("свет цветной яркий");

КонецПроцедуры

&Тест
&Изолированный
Процедура ВместоСтроитсяОтдельнымОбъектом() Экспорт

	// Дано
	Касса = Поделка.НайтиЖелудь("Касса");

	// Тогда
	// Дополнения и сторонний напильник объединены в один декоратор поверх адаптации
	СлойАдаптации = ОбработкаДекоратора.ИсходныйОбъект(Касса);
	Ожидаем.Что(ОбработкаДекоратора.ЭтоДекоратор(СлойАдаптации), "Адаптация - отдельный объект").ЭтоИстина();

	// Адаптация вложена поверх исправления, иначе продолжение не прошло бы через него
	СлойИсправления = ОбработкаДекоратора.ИсходныйОбъект(СлойАдаптации);
	Ожидаем.Что(ОбработкаДекоратора.ЭтоДекоратор(СлойИсправления), "Исправление - отдельный слой").ЭтоИстина();

	ИсходнаяКасса = ОбработкаДекоратора.ИсходныйОбъект(СлойИсправления);
	Ожидаем.Что(ОбработкаДекоратора.ЭтоДекоратор(ИсходнаяКасса), "Под исправлением - сама касса").ЭтоЛожь();
	Ожидаем.Что(ИсходнаяКасса).ИмеетТип("Касса");

КонецПроцедуры

&Тест
&Изолированный
Процедура ВместоБезПродолженияОбъединяетсяИОтсекаетПримененныеРаньше() Экспорт

	// Дано
	Термометр = Поделка.НайтиЖелудь("Термометр");

	// Когда
	Результат = Термометр.Температура();

	// Тогда
	Ожидаем.Что(Результат).Равно(20);
	Ожидаем.Что(Журнал().Количество(), "Не выполнились ни исправление, ни сам метод").Равно(0);

	ИсходныйТермометр = ОбработкаДекоратора.ИсходныйОбъект(Термометр);
	Ожидаем.Что(ОбработкаДекоратора.ЭтоДекоратор(ИсходныйТермометр), "Слои объединены в один декоратор").ЭтоЛожь();

КонецПроцедуры

