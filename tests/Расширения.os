Процедура ВместоБезПродолженияЗаменяетМетод() Экспорт

	// Дано
	Склад = Поделка.НайтиЖелудь("Склад");

	// Когда
	Склад.Принять("болты", 3);
	Остаток = Склад.Остаток("болты");

	// Тогда
	Ожидаем.Что(Остаток).Равно(42);
	Ожидаем.Что(Журнал().Количество()).Равно(1);
