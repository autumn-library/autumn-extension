&Тест
&Изолированный
Процедура ПослеНеВыполняетсяЕслиМетодУпал() Экспорт

	// Дано
	Склад = Поделка.НайтиЖелудь("Склад");

	// Когда
	Попытка
		Склад.Списать("гайки");
		ВызватьИсключение "Ожидалось исключение из метода Списать";
	Исключение
		ТекстОшибки = ИнформацияОбОшибке().Описание;
	КонецПопытки;

	// Тогда
	Ожидаем.Что(ТекстОшибки).Содержит("Списание запрещено: гайки");
	Ожидаем.Что(Журнал().Количество()).Равно(0);

КонецПроцедуры

