&Тест
&Изолированный
Процедура МетодыРасширенияСтановятсяМетодамиЖелудя() Экспорт

	// Дано
	Калькулятор = Поделка.НайтиЖелудь("Калькулятор");

	// Когда
	Калькулятор.Сложить(1, 2);

	// Тогда
	Ожидаем.Что(Калькулятор.РазмерКэша()).Равно(1);
	Ожидаем.Что(Калькулятор.Округлить(1.23456), "Значение по умолчанию из метода расширения").Равно(1.23);
	Ожидаем.Что(Калькулятор.Округлить(1.23456, 3)).Равно(1.235);

КонецПроцедуры

&Тест
&Изолированный
Процедура АннотацииМетодаРасширенияПереносятсяНаЖелудь() Экспорт

	// Дано
	Калькулятор = Поделка.НайтиЖелудь("Калькулятор");

	// Когда
	Методы = Новый Рефлектор().ПолучитьТаблицуМетодов(Калькулятор);

	// Тогда
	Аннотация = Методы.Найти("РазмерКэша", "Имя").Аннотации.Найти("Отладочный", "Имя");
	Ожидаем.Что(Аннотация, "Аннотация метода").Не_().Равно(Неопределено);
	Ожидаем.Что(Аннотация.Параметры.Найти("Уровень", "Имя").Значение).Равно("подробно");

	Параметр = Методы.Найти("Округлить", "Имя").Параметры.Найти("Точность", "Имя");
	АннотацияПараметра = Параметр.Аннотации.Найти("Единица", "Имя");
	Ожидаем.Что(АннотацияПараметра, "Аннотация параметра").Не_().Равно(Неопределено);
	Ожидаем.Что(АннотацияПараметра.Параметры[0].Значение).Равно("знаков");

КонецПроцедуры

