&Тест
&Изолированный
Процедура ПолеРасширенияНеСовпадаетСПолемЖелудя() Экспорт

	// Дано
	// У принтера есть поле с именем, которое напильник выбрал бы для расширения
	Принтер = Поделка.НайтиЖелудь("Принтер");

	// Когда
	Свойства = Новый Рефлектор().ПолучитьТаблицуСвойств(Принтер, Истина);

	// Тогда
	Ожидаем.Что(Принтер.Напечатать("текст")).Равно("[текст]");
	Ожидаем.Что(Свойства.Найти("Расширение_РасширениеУстройства_2", "Имя")).Не_().Равно(Неопределено);

