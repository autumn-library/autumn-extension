&Тест
Процедура НапильникПропускаетНеСозданныйЖелудь() Экспорт

	// Дано
	// Так ОСень вызывает напильники, если завязь не создала желудь
	Напильник = Поделка.НайтиЖелудь("ОбработкаНапильникомРасширенияДополнение");
	ОпределениеКассы = Поделка.ПолучитьОпределениеЖелудя("Касса");

	// Когда
	Результат = Напильник.ОбработатьЖелудь(Неопределено, ОпределениеКассы);

	// Тогда
	Ожидаем.Что(Результат).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура БезРасширенийНазначенияЖелудьНеМеняется() Экспорт

	// Дано
	Применитель = Новый ПрименительРасширений(Поделка);
	Касса = Новый Касса(Поделка.НайтиЖелудь("ЖурналВызовов"));

	// Когда
	Результат = Применитель.Применить(Касса, Поделка.ПолучитьОпределениеЖелудя("Касса"), НазначенияРасширений.Дополнение());

	// Тогда
	Ожидаем.Что(Результат).Равно(Касса);

КонецПроцедуры

Функция Журнал()
	Возврат Поделка.НайтиЖелудь("ЖурналВызовов").События();
КонецФункции
