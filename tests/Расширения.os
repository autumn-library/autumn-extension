&Тест
&Изолированный
Процедура РасширениеЯвляетсяЖелудем() Экспорт

	// Дано
	Определение = Поделка.ПолучитьОпределениеЖелудя("КэшКалькулятора");

	// Тогда
	Ожидаем.Что(Определение).Не_().Равно(Неопределено);
	Ожидаем.Что(Определение.Прозвища().Найти("Расширение")).Не_().Равно(Неопределено);
	Ожидаем.Что(Определение.Характер()).Равно(ХарактерыЖелудей.Компанейский());
	Ожидаем.Что(Поделка.НайтиЖелуди("Расширение").Количество()).Больше(0);

