&Изолированный
Процедура ВместоПродолжаетВызовФункции() Экспорт

	// Дано
	Калькулятор = Поделка.НайтиЖелудь("Калькулятор");

	// Когда
	Первый = Калькулятор.Сложить(2, 3);
	Второй = Калькулятор.Сложить(2, 3);

	// Тогда
	Ожидаем.Что(Первый).Равно(5);
	Ожидаем.Что(Второй).Равно(5);
	Ожидаем.Что(Журнал().Количество(), "Второй вызов взят из кэша расширения").Равно(1);

